# --- Backend Environment Variables ---
# Database URL (Used by FastAPI. If blank, backend automatically defaults to sqlite:///./careersync.db for convenience)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careersync

# Secret key used for JWT signing and verification
JWT_SECRET=super-secret-key-change-in-production-123456

# Google Gemini API Key (Required for AI matching and parsing. If blank, mock fallbacks are used)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend server port (Default: 8000)
PORT=8000


# --- Frontend Environment Variables ---
# Public API URL that frontend contacts (Default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
